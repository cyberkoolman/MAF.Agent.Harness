{
  "AzureOpenAI": {
    "Endpoint": "https://<your-resource>.openai.azure.com/",
    "Deployment": "gpt-4o"
  },
  "AzureMonitor": {
    "ConnectionString": "",
    "ServiceName": "MAF.Agent.Harness",
    "Environment": "Development"
  },
  "Mission": {
    "//": "Run from the repository root so this resolves to the included sample application.",
    "WorkspaceRoot": "sample-app",
    "FrontendUrl": "http://localhost:3001",
    "BackendUrl": "http://localhost:4000",
    "AcceptanceMaxRounds": 3
  },
  "Browser": {
    "Enabled": false,
    "Headless": true,
    "NavigationTimeoutSeconds": 15,
    "ActionTimeoutSeconds": 10,
    "LaunchTimeoutSeconds": 30,
    "ViewportWidth": 1440,
    "ViewportHeight": 900,
    "ConsoleCapacity": 200,
    "MaxActionableElements": 40,
    "MaxSnapshotCharacters": 12000
  }
}
